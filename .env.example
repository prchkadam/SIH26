# Use a domain whose A record already points to the VPS public IP.
DOMAIN=demo.example.com
CADDY_EMAIL=team@example.com

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-value

# Leave this localhost-only value when frontend and API are served through the
# same Caddy domain. Add external frontend URLs here if you use any.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SQLite is intentionally used for the hackathon demo, so keep one worker.
UVICORN_WORKERS=1
